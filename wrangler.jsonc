{
  "name": "rhinelab-unig-01-mtail-front",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./core/public"
  },
  "routes": [
    {
      "pattern": "mtail.rhinelaboratory.org",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}